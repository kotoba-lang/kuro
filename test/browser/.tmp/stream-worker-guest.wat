(module
  (memory (export "memory") 1)
  (func (export "run") (param $a i32) (param $b i32) (result i32)
    (local $sum i32)
    (local.set $sum (i32.add (local.get $a) (local.get $b)))
    (i32.store8 (i32.const 2048) (i32.const 115))
    (i32.store8 (i32.const 2049) (i32.const 117))
    (i32.store8 (i32.const 2050) (i32.const 109))
    (i32.store8 (i32.const 2051) (i32.const 61))
    (i32.store8 (i32.const 2052) (i32.add (i32.const 48)
                 (i32.div_u (local.get $sum) (i32.const 10))))
    (i32.store8 (i32.const 2053) (i32.add (i32.const 48)
                 (i32.rem_u (local.get $sum) (i32.const 10))))
    (local.get $sum)))
